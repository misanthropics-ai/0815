# Copy to backend/.env and fill in. backend/.env is gitignored.

# --- AWS Bedrock (required for live LLM: intents / judge / simulate / debate / report) ---
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Bedrock models (leave empty => auto-discover best available Claude at startup) ---
BEDROCK_MODEL=
BEDROCK_FAST_MODEL=
BEDROCK_MAX_CONCURRENCY=4

# --- Engines: all LLM via Bedrock. Default engine set for runs ---
DEFAULT_ENGINES=sim-sonnet,sim-haiku

# --- Server ---
PORT=8000
# MODE: auto (use live components when creds exist, else mock) | mock | live
MODE=auto
